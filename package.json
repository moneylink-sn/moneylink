{
  "name": "moneylink",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MoneyLink Fintech Platform — Séquestre (Escrow), Paiements & Épargne au Sénégal",
  "workspaces": [
    "admin",
    "backend"
  ],
  "scripts": {
    "build": "npm run build --workspace=admin",

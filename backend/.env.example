# ============================================================================
# MONEYLINK BACKEND — CONFIGURATION DES ENVIRONNEMENTS (TEMPLATE)
# ============================================================================
# IMPORTANT : Ne jamais commiter de vrais secrets ou clés d'API dans Git.
#
# Trois environnements prévus :
# 1. DEVELOPMENT : Local avec base PostgreSQL ou stockage mémoire dev
# 2. STAGING     : Serveur de pré-production avec base PostgreSQL staging
# 3. PRODUCTION  : Serveur de production haute disponibilité avec PostgreSQL
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Configuration Générale du Serveur
# ----------------------------------------------------------------------------
# Valeurs possibles : 'development', 'staging', 'production', 'test'
NODE_ENV=development

# Port d'écoute du serveur Node.js (5000 par défaut)
PORT=5000

# ----------------------------------------------------------------------------
# 2. Base de Données Relationnelle (PostgreSQL 15+)
# ----------------------------------------------------------------------------
# Format : postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslmode=require
DATABASE_URL=postgresql://moneylink_user:STRONG_SECURE_PASSWORD@localhost:5432/moneylink_db

# Optionnel : Fallback SQLite pour développement autonome uniquement (false en prod)
USE_SQLITE=false
SQLITE_DB_PATH=../database/moneylink.db

# ----------------------------------------------------------------------------
# 3. Sécurité & Authentification JWT
# ----------------------------------------------------------------------------
# Générer une clé secrète robuste de 64 octets en production : openssl rand -hex 32
JWT_SECRET=moneylink_super_secure_fintech_jwt_secret_key_2026_sn
JWT_EXPIRES_IN=7d

# ----------------------------------------------------------------------------
# 4. Paramètres de Séquestre & Commissions MoneyLink
# ----------------------------------------------------------------------------
# Commission prélevée sur chaque commande séquestre (ex: 1.0 = 1.0% plafonné)
ESCROW_FEE_PERCENT=1.0

# ----------------------------------------------------------------------------
# 5. Passerelles de Paiement Mobile Money (Sénégal)
# ----------------------------------------------------------------------------
# En développement / sandbox :
PAYMENT_MOCK_DELAY_MS=500
WAVE_MERCHANT_ID=WAVE_SN_MONEYLINK_TEST
ORANGE_MONEY_MERCHANT_ID=OM_SN_MONEYLINK_TEST

# En production réelle (Variables requises pour l'agrégation Wave Sénégal & Orange Money) :
WAVE_API_KEY=
WAVE_MERCHANT_ID=
WAVE_WEBHOOK_SECRET=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_ID=
ORANGE_MONEY_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# 6. CORS (Cross-Origin Resource Sharing)
# ----------------------------------------------------------------------------
# En développement local :
CORS_ORIGIN=*

# En production (Obligatoire : URLs sécurisées sans wildcard *) :
# CORS_ORIGIN=https://moneylink.sn,https://www.moneylink.sn,https://admin.moneylink.sn
